# ==============================================================================
# SUPABASE CONFIGURATION (Frontend & Client-Side)
# ==============================================================================
# URL instance Supabase Anda
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anon Publik (Aman terekspos di browser untuk fetch data publik & insert doa)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# PIN Akses Cepat Dashboard Admin (/admin & /scanner)
VITE_ADMIN_PIN=202620

# ==============================================================================
# WORKER BAILEYS CONFIGURATION (HANYA SISI SERVER / LOKAL - JANGAN EKSPOS KE CLIENT)
# ==============================================================================
# Kunci Service Role Supabase (Hanya untuk worker Baileys agar bisa membaca & update wa_outbox)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
