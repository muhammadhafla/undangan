# ==========================================
# Undangan WhatsApp Bridge - Environment
# ==========================================

# Nama Job / Process Identifier (Unik di server saat multi-bridge berjalan)
APP_NAME=undangan-hf-wa-bridge

# Supabase Cloud Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Jitter Delay between blast messages (ms) to avoid WA anti-spam
BROADCAST_MIN_DELAY_MS=5000
BROADCAST_MAX_DELAY_MS=12000

# Storage Directories
# DATA_DIR=./data
